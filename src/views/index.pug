doctype html
html
  head
    title #{title}
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="darkreader-lock")
    link(rel="icon" href="/favicon.ico" sizes="any")
    style.
      body { background-color: #313131; color: #e8e8e8; }
      a { color: white; }
      a:hover { text-decoration: none; }
  body
    h1 #{title}
    p Version: #{version}
    p Badges Generated: #[b #{badges}]
    p Uptime: #{days}:#{hours}:#{minutes}m - Total: #{uptime}s - #[a(href="/uptime" target="_blank") uptime badge]
    each url, label in links
      p #{label}: #[a(href=url target="_blank") #{url}]
